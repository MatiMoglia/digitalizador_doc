{
  "name": "digitalizador_doc",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron electron/main.cjs",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@heroicons/vue": "^2.2.0",
    "bootstrap-icons": "^1.13.1",
    "pdfkit": "^0.17.2",
    "pdfmake": "^0.2.7",
    "vue": "^3.5.24",
    "vue-router": "^4.6.4",
    "vue-toastification": "^2.0.0-rc.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "electron": "^40.0.0",
    "electron-builder": "^26.4.0",
    "vite": "^7.2.4"
  },
  "build": {
    "appId": "com.digitalizador.doc",
    "productName": "Digitalizador de Documentos",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
